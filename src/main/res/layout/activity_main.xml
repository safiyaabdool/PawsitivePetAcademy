<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:paddingStart="18dp" android:paddingEnd="10dp" android:gravity="center_vertical"
        android:background="@color/white">
        <ImageView android:layout_width="38dp" android:layout_height="38dp"
            android:src="@drawable/ic_paw" android:contentDescription="Paw logo"/>
        <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:text="Pawsitive Pet Academy"
            android:textColor="@color/dark_text" android:textSize="20sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Open menu"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/contentLayout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Care. Trust. Growth." android:textSize="32sp" android:textStyle="bold"
    android:textColor="@color/dark_text" android:layout_marginTop="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Pet education that helps you care with confidence." android:textSize="17sp"
    android:textColor="@color/muted_text" android:layout_marginTop="6dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="180dp"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:background="@drawable/bg_gradient" android:layout_marginTop="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🐾" android:textSize="46sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Learn. Train. Grow." android:textColor="@color/white"
        android:textSize="24sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Explore practical pet-care education for owners, pet-care professionals and animal lovers."
    android:textColor="@color/dark_text" android:textSize="16sp" android:layout_marginTop="22dp"/>
<Button android:id="@+id/sixMonthButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Explore 6-Month Courses" android:textColor="@color/white"
    android:background="@drawable/button_primary" android:layout_marginTop="20dp"/>
<Button android:id="@+id/sixWeekButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Explore 6-Week Courses" android:textColor="@color/blue_dark"
    android:background="@drawable/button_secondary" android:layout_marginTop="10dp"/>
<Button android:id="@+id/quoteButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Calculate My Fees" android:textColor="@color/blue_dark"
    android:background="@drawable/button_secondary" android:layout_marginTop="10dp"/>
<Button android:id="@+id/contactButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Contact &amp; Venues" android:textColor="@color/blue_dark"
    android:background="@drawable/button_secondary" android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
